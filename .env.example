# ==============================================================================
# HIREFLOW ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hireflow
DB_USER=hireflow
DB_PASS=hireflow_secret_password

# Backend Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security
# Use a cryptographically secure random base64 string in production (at least 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Storage
FILE_STORAGE_DIR=./data/uploads
FILE_MAX_SIZE_BYTES=10485760

# CORS & Client URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8080/api/v1
